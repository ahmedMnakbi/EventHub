{% extends 'base.html.twig' %}

{% block body %}
    {% set route = app.current_route %}
    <div class="row g-4">
        <aside class="col-lg-3">
            <div class="card p-3">
                <div class="text-center mb-3">
                    <i class="bi bi-person-circle fs-1 text-primary"></i>
                    <div class="fw-semibold">{{ app.user.fullName }}</div>
                    <div class="small text-muted">{{ app.user.email }}</div>
                </div>
                <nav class="nav nav-pills flex-column">
                    <a class="nav-link {{ route == 'app_account' ? 'active' }}" href="{{ path('app_account') }}"><i class="bi bi-person"></i> Mon profil</a>
                    <a class="nav-link {{ route == 'app_account_edit' ? 'active' }}" href="{{ path('app_account_edit') }}"><i class="bi bi-pencil"></i> Modifier mes infos</a>
                    <a class="nav-link {{ route == 'app_account_password' ? 'active' }}" href="{{ path('app_account_password') }}"><i class="bi bi-key"></i> Mot de passe</a>
                    <span class="nav-link disabled"><i class="bi bi-ticket"></i> Mes réservations <span class="badge text-bg-light">étape 6</span></span>
                </nav>
            </div>
        </aside>
        <section class="col-lg-9">
            <div class="card p-4">
                {% block account_content %}{% endblock %}
            </div>
        </section>
    </div>
{% endblock %}
