{% extends 'account/_layout.html.twig' %}

{% block title %}Changer de mot de passe{% endblock %}

{% block account_content %}
    <h1 class="h4 mb-4">Changer de mot de passe</h1>
    {{ form_start(form) }}
        {{ form_rest(form) }}
        <button type="submit" class="btn btn-primary">Mettre à jour</button>
        <a href="{{ path('app_account') }}" class="btn btn-link">Annuler</a>
    {{ form_end(form) }}
{% endblock %}
