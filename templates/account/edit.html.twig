{% extends 'account/_layout.html.twig' %}

{% block title %}Modifier mon profil{% endblock %}

{% block account_content %}
    <h1 class="h4 mb-4">Modifier mes informations</h1>
    {{ form_start(form) }}
        <div class="row">
            <div class="col-md-6">{{ form_row(form.firstName) }}</div>
            <div class="col-md-6">{{ form_row(form.lastName) }}</div>
        </div>
        {{ form_rest(form) }}
        <button type="submit" class="btn btn-primary">Enregistrer</button>
        <a href="{{ path('app_account') }}" class="btn btn-link">Annuler</a>
    {{ form_end(form) }}
{% endblock %}
