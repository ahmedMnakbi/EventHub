{% extends 'admin/base.html.twig' %}

{% set is_new = zone.id is null %}

{% block title %}{{ is_new ? 'Nouvelle zone' : 'Modifier la zone' }} · Admin{% endblock %}
{% block page_title %}{{ is_new ? 'Nouvelle zone' : 'Modifier la zone « ' ~ zone.name ~ ' »' }}{% endblock %}

{% block admin_content %}
    <div class="card p-3 p-md-4" style="max-width: 720px">
        <p class="text-muted">
            <i class="bi bi-geo-alt"></i> {{ venue.name }} ({{ venue.city }}) ·
            {{ venue.zonesCapacity|number_format(0, ',', ' ') }} / {{ venue.capacity|number_format(0, ',', ' ') }} places déjà réparties
        </p>
        {{ form_start(form) }}
            <div class="row">
                <div class="col-sm-7">{{ form_row(form.name) }}</div>
                <div class="col-sm-5">{{ form_row(form.capacity) }}</div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> {{ is_new ? 'Ajouter' : 'Enregistrer' }}</button>
                <a href="{{ path('admin_venue_show', {id: venue.id}) }}" class="btn btn-outline-secondary">Annuler</a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
