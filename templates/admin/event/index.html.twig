{% extends 'admin/base.html.twig' %}

{% block title %}Événements · Admin{% endblock %}
{% block page_title %}Événements{% endblock %}

{% block admin_content %}
    <div class="card p-3 p-md-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <span class="text-muted">{{ events.totalItemCount }} événement(s)</span>
            <a href="{{ path('admin_event_new') }}" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Nouvel événement</a>
        </div>

        {% embed 'admin/_search_bar.html.twig' with {placeholder: 'Titre, lieu ou ville…'} %}
            {% block filters %}
                <div class="col-sm-6 col-xl-3">
                    <select name="category" class="form-select" aria-label="Catégorie">
                        <option value="">Toutes les catégories</option>
                        {% for c in categories %}
                            <option value="{{ c.id }}" {{ c.id == category_id ? 'selected' }}>{{ c.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-sm-6 col-xl-2">
                    <select name="status" class="form-select" aria-label="Statut">
                        <option value="">Tous les statuts</option>
                        {% for s in statuses %}
                            <option value="{{ s.value }}" {{ s == status ? 'selected' }}>{{ s.label }}</option>
                        {% endfor %}
                    </select>
                </div>
            {% endblock %}
        {% endembed %}

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 64px"></th>
                        <th>{{ knp_pagination_sortable(events, 'Titre', 'e.title') }}</th>
                        <th class="d-none d-md-table-cell">{{ knp_pagination_sortable(events, 'Lieu', 'v.city') }}</th>
                        <th>{{ knp_pagination_sortable(events, 'Date', 'e.startAt') }}</th>
                        <th class="d-none d-sm-table-cell">{{ knp_pagination_sortable(events, 'Statut', 'e.status') }}</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for event in events %}
                        <tr>
                            <td>
                                {% if event.image %}
                                    <img src="{{ asset(event_upload_path ~ '/' ~ event.image) }}" alt="" class="event-thumb" loading="lazy">
                                {% else %}
                                    <span class="event-thumb d-inline-flex align-items-center justify-content-center bg-light text-muted"><i class="bi bi-image"></i></span>
                                {% endif %}
                            </td>
                            <td>
                                <a href="{{ path('admin_event_show', {id: event.id}) }}" class="fw-semibold text-decoration-none">{{ event.title }}</a>
                                <div class="small text-muted"><i class="bi {{ event.category.icon ?: 'bi-tag' }}"></i> {{ event.category.name }}</div>
                            </td>
                            <td class="d-none d-md-table-cell">
                                {{ event.venue.name }}
                                <div class="small text-muted">{{ event.venue.city }}</div>
                            </td>
                            <td class="text-nowrap">
                                {{ event.startAt|date('d/m/Y') }}
                                <div class="small text-muted">{{ event.startAt|date('H:i') }}{% if event.past %} · <span class="text-warning">passé</span>{% endif %}</div>
                            </td>
                            <td class="d-none d-sm-table-cell"><span class="badge text-bg-{{ event.status.color }}">{{ event.status.label }}</span></td>
                            <td class="text-end text-nowrap">
                                <a href="{{ path('admin_event_show', {id: event.id}) }}" class="btn btn-sm btn-outline-secondary" title="Détails et billets"><i class="bi bi-eye"></i></a>
                                <a href="{{ path('admin_event_edit', {id: event.id}) }}" class="btn btn-sm btn-outline-primary" title="Modifier"><i class="bi bi-pencil"></i></a>
                                {{ include('admin/_delete_form.html.twig', {
                                    action: path('admin_event_delete', {id: event.id}),
                                    token_id: 'delete-event-' ~ event.id,
                                    message: 'Supprimer l\'événement « ' ~ event.title ~ ' » et ses types de billets ?'
                                }) }}
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="6" class="text-center text-muted py-4">Aucun événement trouvé.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="mt-3">{{ knp_pagination_render(events) }}</div>
    </div>
{% endblock %}
