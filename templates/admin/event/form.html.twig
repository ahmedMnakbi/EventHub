{% extends 'admin/base.html.twig' %}

{% set is_new = event.id is null %}

{% block title %}{{ is_new ? 'Nouvel événement' : 'Modifier l\'événement' }} · Admin{% endblock %}
{% block page_title %}{{ is_new ? 'Nouvel événement' : 'Modifier « ' ~ event.title ~ ' »' }}{% endblock %}

{% block admin_content %}
    <div class="card p-3 p-md-4" style="max-width: 900px">
        {{ form_start(form) }}
            {{ form_errors(form) }}
            {{ form_row(form.title) }}
            <div class="row">
                <div class="col-md-6">{{ form_row(form.category) }}</div>
                <div class="col-md-6">{{ form_row(form.venue) }}</div>
            </div>
            <div class="row">
                <div class="col-md-4">{{ form_row(form.startAt) }}</div>
                <div class="col-md-4">{{ form_row(form.endAt) }}</div>
                <div class="col-md-4">{{ form_row(form.status) }}</div>
            </div>
            {{ form_row(form.description) }}

            {% if form.removeImages is defined %}
                <fieldset class="mb-3">
                    <legend class="form-label fs-6">Images actuelles <small class="text-muted">(cochez celles à supprimer ; la première sert d'affiche)</small></legend>
                    <div class="d-flex flex-wrap gap-3">
                        {% for choice in form.removeImages %}
                            <label class="text-center small" for="{{ choice.vars.id }}">
                                <img src="{{ asset(event_upload_path ~ '/' ~ choice.vars.value) }}" alt="Image {{ loop.index }}" class="rounded border d-block mb-1 event-thumb-lg">
                                <input type="checkbox" class="form-check-input" id="{{ choice.vars.id }}" name="{{ choice.vars.full_name }}" value="{{ choice.vars.value }}" {{ choice.vars.checked ? 'checked' }}>
                                {{ loop.first ? 'Affiche' : 'Supprimer' }}{% if loop.first %} · supprimer{% endif %}
                            </label>
                            {% do choice.setRendered %}
                        {% endfor %}
                    </div>
                    {{ form_errors(form.removeImages) }}
                </fieldset>
            {% endif %}
            {{ form_row(form.imageFiles, {help: is_new ? form.imageFiles.vars.help : 'Laissez vide pour garder les images actuelles. ' ~ form.imageFiles.vars.help}) }}

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> {{ is_new ? 'Créer' : 'Enregistrer' }}</button>
                <a href="{{ is_new ? path('admin_event_index') : path('admin_event_show', {id: event.id}) }}" class="btn btn-outline-secondary">Annuler</a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
