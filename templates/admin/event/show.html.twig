{% extends 'admin/base.html.twig' %}

{% block title %}{{ event.title }} · Admin{% endblock %}
{% block page_title %}{{ event.title }}{% endblock %}

{% block admin_content %}
    <div class="mb-3">
        <a href="{{ path('admin_event_index') }}" class="text-decoration-none"><i class="bi bi-arrow-left"></i> Tous les événements</a>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card overflow-hidden">
                {% if event.image %}
                    <img src="{{ asset(event_upload_path ~ '/' ~ event.image) }}" alt="Affiche de {{ event.title }}" class="card-img-top">
                {% endif %}
                <div class="card-body">
                    <span class="badge text-bg-{{ event.status.color }} mb-2">{{ event.status.label }}</span>
                    {% if event.past %}<span class="badge text-bg-warning mb-2">Passé</span>{% endif %}
                    <dl class="mb-0 small">
                        <dt>Catégorie</dt>
                        <dd><i class="bi {{ event.category.icon ?: 'bi-tag' }}"></i> {{ event.category.name }}</dd>
                        <dt>Lieu</dt>
                        <dd>{{ event.venue.name }}, {{ event.venue.address }} ({{ event.venue.city }})</dd>
                        <dt>Dates</dt>
                        <dd>Du {{ event.startAt|date('d/m/Y à H:i') }}<br>au {{ event.endAt|date('d/m/Y à H:i') }}</dd>
                        <dt>Créé le</dt>
                        <dd class="mb-0">{{ event.createdAt|date('d/m/Y') }}</dd>
                    </dl>
                </div>
                <div class="card-footer bg-transparent d-flex gap-2">
                    <a href="{{ path('admin_event_edit', {id: event.id}) }}" class="btn btn-sm btn-primary"><i class="bi bi-pencil"></i> Modifier</a>
                    {{ include('admin/_delete_form.html.twig', {
                        action: path('admin_event_delete', {id: event.id}),
                        token_id: 'delete-event-' ~ event.id,
                        message: 'Supprimer l\'événement « ' ~ event.title ~ ' » et ses types de billets ?',
                        label: 'Supprimer'
                    }) }}
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card p-3 p-md-4 mb-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <h2 class="h5 mb-0">Types de billets</h2>
                    <a href="{{ path('admin_ticket_type_new', {id: event.id}) }}" class="btn btn-sm btn-primary"><i class="bi bi-plus-lg"></i> Ajouter un billet</a>
                </div>

                {% set capacity = event.venue.capacity %}
                {% set total = event.totalQuantity %}
                <div class="small text-muted mb-1">
                    {{ total|number_format(0, ',', ' ') }} / {{ capacity|number_format(0, ',', ' ') }} places du lieu mises en vente
                    · {{ event.totalSold|number_format(0, ',', ' ') }} vendue(s)
                </div>
                <div class="progress mb-3" role="progressbar" aria-label="Places mises en vente" aria-valuenow="{{ total }}" aria-valuemin="0" aria-valuemax="{{ capacity }}" style="height: 6px">
                    <div class="progress-bar" style="width: {{ capacity > 0 ? (total * 100 / capacity)|round : 0 }}%"></div>
                </div>

                {% if event.ticketTypes is empty %}
                    <div class="alert alert-warning mb-0">
                        <i class="bi bi-exclamation-triangle"></i> Aucun type de billet : l'événement ne peut pas encore être publié.
                    </div>
                {% else %}
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Billet</th>
                                    <th class="text-end">Prix</th>
                                    <th class="text-end">Places</th>
                                    <th class="text-end d-none d-xl-table-cell">Vendus</th>
                                    <th class="text-end">Restants</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for ticket in event.ticketTypes %}
                                    <tr>
                                        <td class="fw-semibold">{{ ticket.name }}</td>
                                        <td class="text-end text-nowrap">{{ ticket.price|number_format(2, ',', ' ') }} DT</td>
                                        <td class="text-end">{{ ticket.quantity }}</td>
                                        <td class="text-end d-none d-xl-table-cell">{{ ticket.sold }}</td>
                                        <td class="text-end">
                                            {% if ticket.soldOut %}<span class="badge text-bg-danger">Complet</span>{% else %}{{ ticket.remaining }}{% endif %}
                                        </td>
                                        <td class="text-end text-nowrap">
                                            <a href="{{ path('admin_ticket_type_edit', {id: ticket.id}) }}" class="btn btn-sm btn-outline-primary" title="Modifier"><i class="bi bi-pencil"></i></a>
                                            {{ include('admin/_delete_form.html.twig', {
                                                action: path('admin_ticket_type_delete', {id: ticket.id}),
                                                token_id: 'delete-ticket-type-' ~ ticket.id,
                                                message: 'Supprimer le billet « ' ~ ticket.name ~ ' » ?'
                                            }) }}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>

            <div class="card p-3 p-md-4">
                <h2 class="h5">Description</h2>
                {# Plain text: escaped by Twig, line breaks kept with nl2br (applied after escaping). #}
                <p class="mb-0 text-body-secondary">{{ event.description|nl2br }}</p>
            </div>
        </div>
    </div>
{% endblock %}
