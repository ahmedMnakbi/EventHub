{% extends 'admin/base.html.twig' %}

{% block title %}Lieux · Admin{% endblock %}
{% block page_title %}Lieux{% endblock %}

{% block admin_content %}
    <div class="card p-3 p-md-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <span class="text-muted">{{ venues.totalItemCount }} lieu(x)</span>
            <a href="{{ path('admin_venue_new') }}" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Nouveau lieu</a>
        </div>

        {% embed 'admin/_search_bar.html.twig' with {placeholder: 'Rechercher un lieu ou une adresse…'} %}
            {% block filters %}
                <div class="col-sm-4 col-md-3">
                    <select name="city" class="form-select" aria-label="Ville">
                        <option value="">Toutes les villes</option>
                        {% for c in cities %}
                            <option value="{{ c }}" {{ c == city ? 'selected' }}>{{ c }}</option>
                        {% endfor %}
                    </select>
                </div>
            {% endblock %}
        {% endembed %}

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>{{ knp_pagination_sortable(venues, 'Nom', 'v.name') }}</th>
                        <th class="d-none d-md-table-cell">Adresse</th>
                        <th>{{ knp_pagination_sortable(venues, 'Ville', 'v.city') }}</th>
                        <th class="text-end">{{ knp_pagination_sortable(venues, 'Capacité', 'v.capacity') }}</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for venue in venues %}
                        <tr>
                            <td><a href="{{ path('admin_venue_show', {id: venue.id}) }}" class="fw-semibold text-decoration-none">{{ venue.name }}</a></td>
                            <td class="d-none d-md-table-cell text-muted">{{ venue.address }}</td>
                            <td>{{ venue.city }}</td>
                            <td class="text-end">{{ venue.capacity|number_format(0, ',', ' ') }}</td>
                            <td class="text-end text-nowrap">
                                <a href="{{ path('admin_venue_show', {id: venue.id}) }}" class="btn btn-sm btn-outline-secondary" title="Détails et zones"><i class="bi bi-eye"></i></a>
                                <a href="{{ path('admin_venue_edit', {id: venue.id}) }}" class="btn btn-sm btn-outline-primary" title="Modifier"><i class="bi bi-pencil"></i></a>
                                {{ include('admin/_delete_form.html.twig', {
                                    action: path('admin_venue_delete', {id: venue.id}),
                                    token_id: 'delete-venue-' ~ venue.id,
                                    message: 'Supprimer le lieu « ' ~ venue.name ~ ' » ?'
                                }) }}
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="5" class="text-center text-muted py-4">Aucun lieu trouvé.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="mt-3">{{ knp_pagination_render(venues) }}</div>
    </div>
{% endblock %}
