{% extends 'admin/base.html.twig' %}

{% block title %}{{ venue.name }} · Admin{% endblock %}
{% block page_title %}{{ venue.name }}{% endblock %}

{% block admin_content %}
    <div class="mb-3">
        <a href="{{ path('admin_venue_index') }}" class="text-decoration-none"><i class="bi bi-arrow-left"></i> Tous les lieux</a>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card">
                <div class="card-body">
                    <dl class="mb-0 small">
                        <dt>Adresse</dt>
                        <dd>{{ venue.address }}</dd>
                        <dt>Ville</dt>
                        <dd>{{ venue.city }}</dd>
                        <dt>Capacité totale</dt>
                        <dd>{{ venue.capacity|number_format(0, ',', ' ') }} places</dd>
                        <dt>Événements</dt>
                        <dd class="mb-0">{{ event_count }}</dd>
                    </dl>
                </div>
                <div class="card-footer bg-transparent d-flex gap-2">
                    <a href="{{ path('admin_venue_edit', {id: venue.id}) }}" class="btn btn-sm btn-primary"><i class="bi bi-pencil"></i> Modifier</a>
                    {{ include('admin/_delete_form.html.twig', {
                        action: path('admin_venue_delete', {id: venue.id}),
                        token_id: 'delete-venue-' ~ venue.id,
                        message: 'Supprimer le lieu « ' ~ venue.name ~ ' » et ses zones ?',
                        label: 'Supprimer'
                    }) }}
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card p-3 p-md-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <h2 class="h5 mb-0">Zones</h2>
                    <a href="{{ path('admin_zone_new', {id: venue.id}) }}" class="btn btn-sm btn-primary"><i class="bi bi-plus-lg"></i> Ajouter une zone</a>
                </div>

                {% set used = venue.zonesCapacity %}
                <div class="small text-muted mb-1">
                    {{ used|number_format(0, ',', ' ') }} / {{ venue.capacity|number_format(0, ',', ' ') }} places réparties en zones
                </div>
                <div class="progress mb-3" role="progressbar" aria-label="Places réparties" aria-valuenow="{{ used }}" aria-valuemin="0" aria-valuemax="{{ venue.capacity }}" style="height: 6px">
                    <div class="progress-bar" style="width: {{ venue.capacity > 0 ? (used * 100 / venue.capacity)|round : 0 }}%"></div>
                </div>

                {% if venue.zones is empty %}
                    <div class="alert alert-warning mb-0">
                        <i class="bi bi-exclamation-triangle"></i> Aucune zone : ce lieu ne peut pas encore accueillir d'événement.
                    </div>
                {% else %}
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Zone</th>
                                    <th class="text-end">Capacité</th>
                                    <th class="text-end d-none d-sm-table-cell">Types de billets</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for zone in venue.zones %}
                                    <tr>
                                        <td class="fw-semibold">{{ zone.name }}</td>
                                        <td class="text-end">{{ zone.capacity|number_format(0, ',', ' ') }}</td>
                                        <td class="text-end d-none d-sm-table-cell">{{ zone.ticketTypes|length }}</td>
                                        <td class="text-end text-nowrap">
                                            <a href="{{ path('admin_zone_edit', {id: zone.id}) }}" class="btn btn-sm btn-outline-primary" title="Modifier"><i class="bi bi-pencil"></i></a>
                                            {{ include('admin/_delete_form.html.twig', {
                                                action: path('admin_zone_delete', {id: zone.id}),
                                                token_id: 'delete-zone-' ~ zone.id,
                                                message: 'Supprimer la zone « ' ~ zone.name ~ ' » ?'
                                            }) }}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
