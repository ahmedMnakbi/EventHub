{% extends 'admin/base.html.twig' %}

{% set is_new = venue.id is null %}

{% block title %}{{ is_new ? 'Nouveau lieu' : 'Modifier le lieu' }} · Admin{% endblock %}
{% block page_title %}{{ is_new ? 'Nouveau lieu' : 'Modifier « ' ~ venue.name ~ ' »' }}{% endblock %}

{% block admin_content %}
    <div class="card p-3 p-md-4" style="max-width: 720px">
        {{ form_start(form) }}
            {{ form_row(form.name) }}
            {{ form_row(form.address) }}
            <div class="row">
                <div class="col-md-7">{{ form_row(form.city) }}</div>
                <div class="col-md-5">{{ form_row(form.capacity) }}</div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> {{ is_new ? 'Créer' : 'Enregistrer' }}</button>
                <a href="{{ path('admin_venue_index') }}" class="btn btn-outline-secondary">Annuler</a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
