{% extends 'admin/base.html.twig' %}

{% block title %}Catégories · Admin{% endblock %}
{% block page_title %}Catégories{% endblock %}

{% block admin_content %}
    <div class="card p-3 p-md-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <span class="text-muted">{{ categories.totalItemCount }} catégorie(s)</span>
            <a href="{{ path('admin_category_new') }}" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Nouvelle catégorie</a>
        </div>

        {{ include('admin/_search_bar.html.twig', {placeholder: 'Rechercher une catégorie…'}) }}

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 50px"></th>
                        <th>{{ knp_pagination_sortable(categories, 'Nom', 'c.name') }}</th>
                        <th class="d-none d-md-table-cell">Description</th>
                        <th class="d-none d-sm-table-cell">{{ knp_pagination_sortable(categories, 'Créée le', 'c.createdAt') }}</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for category in categories %}
                        <tr>
                            <td><i class="bi {{ category.icon ?: 'bi-tag' }} fs-5 text-primary"></i></td>
                            <td>
                                <div class="fw-semibold">{{ category.name }}</div>
                                <div class="small text-muted">{{ category.slug }}</div>
                            </td>
                            <td class="d-none d-md-table-cell text-muted">{{ category.description|default('—')|u.truncate(70, '…') }}</td>
                            <td class="d-none d-sm-table-cell">{{ category.createdAt|date('d/m/Y') }}</td>
                            <td class="text-end text-nowrap">
                                <a href="{{ path('admin_category_edit', {id: category.id}) }}" class="btn btn-sm btn-outline-primary" title="Modifier"><i class="bi bi-pencil"></i></a>
                                {{ include('admin/_delete_form.html.twig', {
                                    action: path('admin_category_delete', {id: category.id}),
                                    token_id: 'delete-category-' ~ category.id,
                                    message: 'Supprimer la catégorie « ' ~ category.name ~ ' » ?'
                                }) }}
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="5" class="text-center text-muted py-4">Aucune catégorie trouvée.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="mt-3">{{ knp_pagination_render(categories) }}</div>
    </div>
{% endblock %}
