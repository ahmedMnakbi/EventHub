{% extends 'admin/base.html.twig' %}

{% set is_new = ticket_type.id is null %}

{% block title %}{{ is_new ? 'Nouveau billet' : 'Modifier le billet' }} · Admin{% endblock %}
{% block page_title %}{{ is_new ? 'Nouveau type de billet' : 'Modifier le billet « ' ~ ticket_type.name ~ ' »' }}{% endblock %}

{% block admin_content %}
    <div class="card p-3 p-md-4" style="max-width: 720px">
        <p class="text-muted">
            <i class="bi bi-calendar-event"></i> {{ event.title }} · {{ event.venue.name }}
            ({{ event.venue.capacity|number_format(0, ',', ' ') }} places)
            {% if ticket_type.sold > 0 %}<br><i class="bi bi-info-circle"></i> {{ ticket_type.sold }} billet(s) déjà vendu(s).{% endif %}
        </p>
        {{ form_start(form) }}
            {{ form_row(form.name) }}
            <div class="row">
                <div class="col-sm-6">{{ form_row(form.price) }}</div>
                <div class="col-sm-6">{{ form_row(form.quantity) }}</div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> {{ is_new ? 'Ajouter' : 'Enregistrer' }}</button>
                <a href="{{ path('admin_event_show', {id: event.id}) }}" class="btn btn-outline-secondary">Annuler</a>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
