# Uploaded files are data, never code: disable any script execution here (Apache hosting).
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<FilesMatch "\.(?i:php\d?|phtml|phar|pl|py|cgi|sh|html?|svg|js)$">
    Require all denied
</FilesMatch>
Options -Indexes -ExecCGI
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>
